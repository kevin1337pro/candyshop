# Create a private .env with: sh docker/create-env.sh
COMPOSE_PROJECT_NAME=forme
COMPOSE_FILE=docker-compose.yml

# Public canonical URL: never include the internal proxy port here.
SITE_URL=https://vape.miami-enterprise.com
SHOP_DOMAIN=vape.miami-enterprise.com
# 8080 is ONLY the local upstream port for your existing reverse proxy.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# Leave disabled for the single shop. See docker/MULTISITE.md for a new network.
CANDY_MULTISITE=0

DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=
DB_ROOT_PASSWORD=

WP_TITLE="Candy Corner"
WP_ADMIN_USER=forme-admin
WP_ADMIN_EMAIL=
WP_ADMIN_PASSWORD=
