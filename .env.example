# Create a private .env with: sh docker/create-env.sh
COMPOSE_PROJECT_NAME=forme
COMPOSE_FILE=docker-compose.yml

# Local test. For production use https://your-domain and set SHOP_DOMAIN below.
SITE_URL=http://localhost:8080
SHOP_DOMAIN=www.candycorner-essen.de
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# Leave disabled for the single shop. See docker/MULTISITE.md for a new network.
CANDY_MULTISITE=0

DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=
DB_ROOT_PASSWORD=

WP_TITLE="Candy Corner"
WP_ADMIN_USER=forme-admin
WP_ADMIN_EMAIL=
WP_ADMIN_PASSWORD=
